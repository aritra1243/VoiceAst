# ============================================================
# VoiceAst - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ============================================================

# ------------------------------------------------------------
# MongoDB (Optional - for command history)
# Leave default if MongoDB runs locally, or comment out.
# ------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=voice_assistant

# ------------------------------------------------------------
# PostgreSQL (for image & screenshot storage)
# Change password to match your PostgreSQL install.
# Default port is 5432. Database 'voiceast_media' is auto-created.
# ------------------------------------------------------------
POSTGRES_URL=postgresql://postgres:password@localhost:5432/voiceast_media

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# STT - Vosk offline speech model
# Path is relative to the project root (d:\VoiceAst)
# ------------------------------------------------------------
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# ------------------------------------------------------------
# TTS Settings
# TTS_RATE  : words per minute (100=slow, 150=normal, 200=fast)
# TTS_VOLUME: 0.0 (silent) -> 1.0 (full volume)
# ------------------------------------------------------------
TTS_RATE=150
TTS_VOLUME=0.9

# ------------------------------------------------------------
# Custom Local Models (no Ollama required - fully offline)
# Paths are relative to the project root.
# These are generated by running: python models_training/train_all.py
# ------------------------------------------------------------

# Intent classifier (TF-IDF + MLP)
INTENT_MODEL_PATH=models_training/saved_models/intent_model.pkl
INTENT_VECTORIZER_PATH=models_training/saved_models/intent_vectorizer.pkl
INTENT_ENCODER_PATH=models_training/saved_models/intent_label_encoder.pkl

# Speaker identification (custom LSTM d-vector encoder)
SPEAKER_MODEL_PATH=models_training/saved_models/speaker_model.pth

# Vision / face recognition model
VISION_MODEL_PATH=models_training/saved_models/vision_model.pth
VISION_VOCAB_PATH=models_training/saved_models/vision_vocab.json

# Owner voice profile (created when you say "enroll voice")
OWNER_VOICE_PATH=models/owner_voice.npy

# ------------------------------------------------------------
# AI Settings (fully local - no internet needed)
# Set to false to disable AI and use pattern matching only
# ------------------------------------------------------------
AI_ENABLED=true

# ------------------------------------------------------------
# Security
# Set to true only if you want to allow risky commands
# (shutdown, delete, format, etc.)
# ------------------------------------------------------------
ENABLE_DANGEROUS_COMMANDS=false
